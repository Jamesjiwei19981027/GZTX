# 本机内测环境变量（配合 docker-compose.beta.yml 使用）
# 用法：
#   cp .env.beta.example .env.beta     （Windows 可用 copy）
#   然后把下面所有 <尖括号> 占位符替换成真实值。.env.beta 已被 .gitignore 忽略，勿提交、勿发给别人。
#
# 后端在 DEBUG=false 时有启动门禁：任何仍含 change-me / example / dev- 等字样的密钥
# 会被拒绝启动，这是保护，不是故障。
#
# 生成强随机值（任选一台装了 Python 的电脑，每个密钥各运行一次，结果各不相同）：
#   python -c "import secrets; print(secrets.token_urlsafe(48))"

# —— 核心 ——
# 必填：登录凭证签名密钥。用上面的命令生成，至少 32 字符。
SECRET_KEY=<随机生成的长字符串>
DEBUG=false
# 必填：用户在浏览器和 APP 里访问的地址。<本机局域网IP> 见手册（ipconfig 里的 IPv4 地址）。
APP_URL=http://<本机局域网IP>:8088
# 与 APP_URL 保持同一个地址（注意是 JSON 数组格式，保留方括号和双引号）
CORS_ORIGINS=["http://<本机局域网IP>:8088"]

# —— 数据库（PostgreSQL，随 compose 一起启动）——
DB_USER=worktodo
# 必填：数据库口令，用上面的命令生成。建议只用字母数字（token_urlsafe 可能含 - 和 _，也可以）。
DB_PASSWORD=<随机生成的数据库口令>
DB_NAME=worktodo
# 必填：口令必须与 DB_PASSWORD 完全一致；主机名固定写 db
DATABASE_URL=postgresql+asyncpg://worktodo:<与DB_PASSWORD完全相同>@db:5432/worktodo

# —— 单公司模式与授权 ——
DEPLOY_MODE=single_company
DEFAULT_COMPANY_SLUG=default
LICENSE_VERIFY_MODE=ed25519
# 必填：运行 gen_license_keypair.py 后屏幕上打印的“公钥”
LICENSE_PUBLIC_KEY=<授权公钥>

# —— 注册策略（新上线）——
# 仅凭邀请链接注册，陌生人不能自助注册
REGISTRATION_MODE=invite_only
# 内测不要求手机验证（没有短信服务）
PHONE_VERIFICATION_REQUIRED=false
# 注册要邮箱验证码（需要先在「设置 → 企业管理」配好发信邮箱，见手册）
REGISTER_VERIFICATION_REQUIRED=true

# —— 邮件（可留空：发信邮箱可在网页「设置 → 企业管理」里配置）——
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# —— 邮件指令通道（不用就保持留空；要启用必须填 IMAP_USER 与强随机 EMAIL_REPLY_SECRET）——
IMAP_USER=
IMAP_PASSWORD=
EMAIL_REPLY_SECRET=
EMAIL_REPLY_DOMAIN=

# —— 音视频通话（内测局域网内可保持默认，STUN 默认指向公网服务，断网时无影响）——
WEBRTC_STUN_URLS=stun:stun.l.google.com:19302
WEBRTC_TURN_URLS=
WEBRTC_TURN_USERNAME=
WEBRTC_TURN_CREDENTIAL=

# —— 其它 ——
# 用于加密公司里保存的第三方密钥（如邮箱授权码、AI 模型密钥）。强烈建议填：用上面的命令生成，
# 并和 .env.beta 一起备份，丢了之前保存的第三方密钥将无法解密。
INTEGRATION_SECRET_KEY=<随机生成的长字符串>
WX_APP_ID=
WX_APP_SECRET=
# 前面有 nginx 反代，保持 true
TRUST_PROXY_HEADERS=true

# 极光安卓系统推送：两个值均非空才启用，无账号时保持留空
# MasterSecret 仅用于服务器，不进入网页、App、日志
JPUSH_APP_KEY=
JPUSH_MASTER_SECRET=
JPUSH_APNS_PRODUCTION=false
