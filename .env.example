# 复制为 .env 后填写（勿提交 .env）
# cp .env.example .env

# —— 核心 ——
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=false
APP_URL=https://app.example.com

# —— 数据库（prod compose）——
DB_USER=worktodo
DB_PASSWORD=change-me-db-password
DB_NAME=worktodo
DATABASE_URL=postgresql+asyncpg://worktodo:change-me-db-password@db:5432/worktodo

# —— 单公司内测 ——
DEPLOY_MODE=single_company
DEFAULT_COMPANY_SLUG=default
LICENSE_VERIFY_MODE=hmac
LICENSE_PUBLIC_KEY=dev-secret-key-change-for-prod
# 生产建议 ed25519 + LICENSE_PUBLIC_KEY=urlsafe-b64(32bytes)

# —— SMTP（欢迎信 / 通知）——
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# —— 其它 ——
INTEGRATION_SECRET_KEY=
CORS_ORIGINS=["https://app.example.com"]
WX_APP_ID=
WX_APP_SECRET=
