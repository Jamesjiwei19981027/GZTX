# 生产部署环境变量（docker-compose.prod.yml 读取本文件）
# 复制为 .env 后**逐项填写真实值**（勿提交 .env）：
#   cp .env.example .env
#
# 注意：后端在 DEBUG=false 下会做启动门禁，任何仍是占位值（含 change-me /
# example / dev- 等字样）的密钥都会**拒绝启动**，不会带着示例密钥跑起来。
# 生成强随机值：
#   python -c "import secrets; print(secrets.token_urlsafe(48))"

# —— 核心 ——
# 必填。JWT 签名密钥，泄露或使用弱值等于任何人可伪造任意用户令牌。
SECRET_KEY=
DEBUG=false
APP_URL=https://app.example.com

# —— 数据库（prod compose 用 PostgreSQL）——
# DB_PASSWORD 必填，且必须与 DATABASE_URL 里的口令保持一致。
DB_USER=worktodo
DB_PASSWORD=
DB_NAME=worktodo
DATABASE_URL=postgresql+asyncpg://worktodo:<与 DB_PASSWORD 相同>@db:5432/worktodo

# —— 单公司内测 ——
DEPLOY_MODE=single_company
DEFAULT_COMPANY_SLUG=default
# 生产必须 ed25519（门禁会拒绝 hmac）；hmac 仅供本地开发。
LICENSE_VERIFY_MODE=ed25519
# 必填：urlsafe-b64 编码的 ed25519 公钥（32 字节）
LICENSE_PUBLIC_KEY=

# —— SMTP（欢迎信 / 通知）——
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# —— 浏览器语音/视频通话（仅信令，媒体端到端留在浏览器）——
# 多个地址用逗号分隔；生产建议同时配置 TURN，避免对称 NAT 无法连通。
WEBRTC_STUN_URLS=stun:stun.l.google.com:19302
WEBRTC_TURN_URLS=
WEBRTC_TURN_USERNAME=
WEBRTC_TURN_CREDENTIAL=

# —— 邮件指令通道（配置 IMAP_USER 才启用）——
# 启用时 EMAIL_REPLY_SECRET 必填强随机值：该通道仅凭 From 地址 + 本密钥鉴权。
IMAP_USER=
IMAP_PASSWORD=
EMAIL_REPLY_SECRET=
EMAIL_REPLY_DOMAIN=

# —— 其它 ——
INTEGRATION_SECRET_KEY=
CORS_ORIGINS=["https://app.example.com"]
WX_APP_ID=
WX_APP_SECRET=

# 反代（nginx）之后才可采信 X-Forwarded-For 做限流。
# 代码默认 false（fail-closed）。compose 会显式设 true。
# 若后端直接暴露公网，必须保持 false，否则可伪造该头绕过 IP 限流。
TRUST_PROXY_HEADERS=true
