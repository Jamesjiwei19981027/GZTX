# 应用配置
APP_NAME=WorkTodo
APP_VERSION=1.0.0
DEBUG=true

# 数据库配置
# SQLite (开发)
DATABASE_URL=sqlite+aiosqlite:///./data/worktodo.db
# PostgreSQL (生产)
# DATABASE_URL=postgresql+asyncpg://worktodo:worktodo123@localhost:5432/worktodo

# JWT 配置
SECRET_KEY=change-this-to-a-strong-secret-key-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# 微信小程序配置
WX_APP_ID=your-wx-app-id
WX_APP_SECRET=your-wx-app-secret

# CORS 配置
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# 上传配置
UPLOAD_DIR=./data/uploads
MAX_UPLOAD_SIZE=5242880

# Email (SMTP) — optional
# SMTP_HOST=smtp.example.com
# SMTP_PORT=465
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=

# Browser WebRTC signaling (media never enters the backend)
WEBRTC_STUN_URLS=stun:stun.l.google.com:19302
WEBRTC_TURN_URLS=
WEBRTC_TURN_USERNAME=
WEBRTC_TURN_CREDENTIAL=

# External IMAP adapter — optional; status stays unavailable until credentials are set.
IMAP_HOST=imap.example.com
IMAP_PORT=993
IMAP_USER=
IMAP_PASSWORD=
EMAIL_REPLY_SECRET=
EMAIL_REPLY_DOMAIN=

# --- Production / collab ---
# APP_URL=https://app.example.com
# DEBUG=false
# DATABASE_URL=postgresql+asyncpg://worktodo:CHANGE_ME@localhost:5432/worktodo

# --- 接口文档 /docs（Swagger）。未设置时跟随 DEBUG；生产开启必须设 ≥12 位密码 ---
# EXPOSE_API_DOCS=true
# API_DOCS_USERNAME=apidocs
# API_DOCS_PASSWORD=
# 「Servers」下拉追加的环境，逗号分隔，每项 地址|说明
# API_DOCS_SERVERS=https://api.your-domain.com|线上,https://staging.your-domain.com|测试
# 国内访问 jsdelivr 不稳时换成可用镜像（需提供 swagger-ui-bundle.js 与 swagger-ui.css）
# API_DOCS_ASSET_BASE=https://cdn.jsdelivr.net/npm/swagger-ui-dist@5

# License: production use ed25519 + public key (urlsafe-b64 raw 32 bytes).
# Dev/tests may use hmac + shared secret in LICENSE_PUBLIC_KEY.
LICENSE_VERIFY_MODE=hmac
LICENSE_PUBLIC_KEY=dev-secret-key-for-tests-only
# LICENSE_PRIVATE_KEY=   # operator signing only; never ship real prod private key in app image

DEPLOY_MODE=single_company
DEFAULT_COMPANY_SLUG=default
INTEGRATION_SECRET_KEY=
COLLAB_OBJECT_ROOT=data/objects
# rule | llm | auto（auto=公司前端配置了 LLM 则用于判定）
JUDGE_BACKEND=auto
# 可选环境变量兜底；优先「公司设置 → LLM」前端配置
# LLM_PROVIDER=openai_compatible
# LLM_BASE_URL=
# LLM_API_KEY=
# LLM_MODEL=
# Dev: auto create_all on boot. Production: false + `alembic upgrade head`
AUTO_CREATE_SCHEMA=true
# Dev/test FakeOIDC only when DEBUG=true
ALLOW_FAKE_SSO=true

# 注册双验证（邮箱+手机）；关闭则回到旧的即时注册
REGISTER_VERIFICATION_REQUIRED=true
# 短信服务商：fake（开发桩，验证码打日志/DEBUG 下接口回显）| 待接 aliyun/tencent
SMS_PROVIDER=fake
