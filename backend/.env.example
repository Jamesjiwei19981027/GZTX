# 应用配置
APP_NAME=WorkTodo
APP_VERSION=1.0.0
DEBUG=true

# 数据库配置
# SQLite (开发)
DATABASE_URL=sqlite+aiosqlite:///./data/worktodo.db
# PostgreSQL (生产)
# DATABASE_URL=postgresql+asyncpg://worktodo:worktodo123@localhost:5432/worktodo

# JWT 配置
SECRET_KEY=change-this-to-a-strong-secret-key-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# 微信小程序配置
WX_APP_ID=your-wx-app-id
WX_APP_SECRET=your-wx-app-secret

# CORS 配置
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# 上传配置
UPLOAD_DIR=./data/uploads
MAX_UPLOAD_SIZE=5242880
