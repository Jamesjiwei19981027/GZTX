FROM node:22-bookworm-slim AS wiki-build
WORKDIR /wiki-engine
COPY wiki-engine/package.json wiki-engine/package-lock.json ./
RUN npm ci --ignore-scripts
COPY wiki-engine/tsconfig.json wiki-engine/bridge.mjs ./
COPY wiki-engine/vendor ./vendor
RUN npm run build && npm prune --omit=dev

FROM python:3.11-slim-bookworm

WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y \
    gcc \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Copy requirements first for better caching
COPY requirements.txt .

# Install Python dependencies
RUN pip install --no-cache-dir -r requirements.txt gunicorn
COPY --from=wiki-build /usr/local/bin/node /usr/local/bin/node
COPY --from=wiki-build /wiki-engine /app/wiki-engine

# Copy only production application and migration sources. Secrets, local data,
# tests, and caches are excluded by backend/.dockerignore.
COPY app ./app
COPY alembic ./alembic
COPY alembic.ini ./alembic.ini

# Create non-root user
RUN adduser --disabled-password --gecos '' appuser && chown -R appuser:appuser /app
USER appuser

# Expose port
EXPOSE 8000

# Use gunicorn for production
CMD ["gunicorn", "app.main:app", "-w", "4", "-k", "uvicorn.workers.UvicornWorker", "--bind", "0.0.0.0:8000", "--access-logfile", "-"]
