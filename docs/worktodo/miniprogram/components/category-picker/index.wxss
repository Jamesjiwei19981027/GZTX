/* 分类选择器组件样式 */

.category-picker {
  display: flex;
  flex-wrap: wrap;
  padding: 16rpx 0;
}

.category-item {
  display: inline-flex;
  align-items: center;
  padding: 12rpx 24rpx;
  margin-right: 16rpx;
  margin-bottom: 16rpx;
  font-size: 26rpx;
  color: var(--text-secondary);
  background-color: var(--bg-color);
  border-radius: 8rpx;
}

.category-item.active {
  color: var(--white);
  background-color: var(--primary-color);
}

.count {
  margin-left: 8rpx;
  font-size: 22rpx;
  opacity: 0.8;
}