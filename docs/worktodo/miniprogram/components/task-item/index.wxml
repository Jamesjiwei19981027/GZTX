<view class="task-item" bindtap="onTap">
  <!-- 完成状态复选框 -->
  <view class="checkbox {{task.status === 2 ? 'checked' : ''}}" bindtap="onComplete">
    <image wx:if="{{task.status === 2}}" class="check-icon" src="/assets/icons/check.png" mode="aspectFit"/>
  </view>

  <!-- 任务内容 -->
  <view class="content">
    <view class="header">
      <!-- 优先级标记 -->
      <view class="priority {{priorityMap[task.priority].class}}">
        {{priorityMap[task.priority].text}}
      </view>
      <!-- 分类 -->
      <view wx:if="{{task.category}}" class="category" style="color: {{task.category.color}}">
        {{task.category.name}}
      </view>
    </view>

    <!-- 任务标题 -->
    <view class="title {{task.status === 2 ? 'completed' : ''}}">{{task.title}}</view>

    <!-- 任务描述 -->
    <view wx:if="{{task.description}}" class="description">{{task.description}}</view>

    <!-- 时间信息 -->
    <view class="footer">
      <view class="time {{task.is_overdue ? 'overdue' : ''}}">
        <image class="time-icon" src="/assets/icons/time.png" mode="aspectFit"/>
        <text>{{formatTime(task.due_date)}}</text>
      </view>

      <!-- 标签 -->
      <view wx:if="{{task.tags.length > 0}}" class="tags">
        <text wx:for="{{task.tags}}" wx:key="id" class="tag" style="color: {{item.color}}">
          {{item.name}}
        </text>
      </view>
    </view>
  </view>

  <!-- 操作按钮 -->
  <view class="actions">
    <view class="action-btn" catchtap="onEdit">
      <image src="/assets/icons/edit.png" mode="aspectFit"/>
    </view>
    <view class="action-btn" catchtap="onDelete">
      <image src="/assets/icons/delete.png" mode="aspectFit"/>
    </view>
  </view>
</view>