<view class="container">
  <!-- 月份导航 -->
  <view class="month-nav">
    <view class="nav-btn prev" bindtap="prevMonth">
      <text class="nav-icon">&lt;</text>
    </view>
    <view class="month-title" bindtap="goToToday">{{monthTitle}}</view>
    <view class="nav-btn next" bindtap="nextMonth">
      <text class="nav-icon">&gt;</text>
    </view>
  </view>

  <!-- 星期标题 -->
  <view class="weekdays">
    <view wx:for="{{weekdays}}" wx:key="index" class="weekday {{item === '日' || item === '六' ? 'weekend' : ''}}">
      {{item}}
    </view>
  </view>

  <!-- 日历网格 -->
  <view class="calendar">
    <view class="calendar-row" wx:for="{{calendarDays}}" wx:for-index="rowIndex" wx:key="rowIndex">
      <view
        wx:for="{{item}}"
        wx:for-item="day"
        wx:key="date"
        class="calendar-cell {{day.isCurrentMonth ? '' : 'other-month'}} {{day.isToday ? 'today' : ''}} {{selectedDate === day.date ? 'selected' : ''}}"
        bindtap="onDateSelect"
        data-date="{{day.date}}"
      >
        <view class="day-number">{{day.date.getDate()}}</view>
        <view wx:if="{{day.hasTask}}" class="task-dot">
          <view class="dot-inner"></view>
        </view>
      </view>
    </view>
  </view>

  <!-- 选中日期的任务列表 -->
  <view class="selected-tasks">
    <view class="tasks-header">
      <text class="tasks-title">{{selectedDate}}</text>
      <text class="tasks-count">{{selectedDateTasks.length}}个任务</text>
    </view>

    <view wx:if="{{selectedDateTasks.length === 0}}" class="no-tasks">
      <text>这天没有任务</text>
    </view>

    <view wx:else class="task-list">
      <view
        wx:for="{{selectedDateTasks}}"
        wx:key="id"
        class="task-item"
        bindtap="onTaskTap"
        data-id="{{item.id}}"
      >
        <view class="task-priority priority-{{item.priority}}"></view>
        <view class="task-content">
          <view class="task-title">{{item.title}}</view>
          <view class="task-time">{{item.due_date}}</view>
        </view>
        <view class="task-status {{item.status === 2 ? 'completed' : ''}}">
          {{item.status === 2 ? '已完成' : item.status === 1 ? '进行中' : '待办'}}
        </view>
      </view>
    </view>
  </view>
</view>