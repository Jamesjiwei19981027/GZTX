/* 首页样式 */

.container {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background-color: var(--bg-color);
}

/* 顶部用户信息栏 */
.header-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 32rpx;
  background-color: var(--primary-color);
  color: var(--white);
}

.user-info {
  display: flex;
  align-items: center;
}

.avatar {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  margin-right: 16rpx;
  background-color: rgba(255, 255, 255, 0.3);
}

.nickname {
  font-size: 28rpx;
}

.today-stats {
  display: flex;
  align-items: center;
}

.stat-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-left: 32rpx;
}

.stat-num {
  font-size: 32rpx;
  font-weight: bold;
}

.stat-label {
  font-size: 20rpx;
  opacity: 0.8;
}

/* 搜索栏 */
.search-bar {
  padding: 16rpx 32rpx;
  background-color: var(--white);
}

.search-input-wrap {
  display: flex;
  align-items: center;
  height: 72rpx;
  padding: 0 24rpx;
  background-color: var(--bg-color);
  border-radius: 36rpx;
}

.search-input {
  flex: 1;
  height: 72rpx;
  padding: 0 16rpx;
  font-size: 28rpx;
}

/* 筛选栏 */
.filter-bar {
  background-color: var(--white);
  border-bottom: 1rpx solid var(--border-color);
}

.filter-tabs {
  display: flex;
  padding: 16rpx 32rpx;
  border-bottom: 1rpx solid var(--border-color);
}

.filter-tab {
  padding: 8rpx 24rpx;
  margin-right: 24rpx;
  font-size: 28rpx;
  color: var(--text-secondary);
  border-radius: 8rpx;
}

.filter-tab.active {
  color: var(--white);
  background-color: var(--primary-color);
}

.category-scroll {
  display: flex;
  padding: 16rpx 32rpx;
  overflow-x: auto;
  white-space: nowrap;
}

.category-tag {
  display: inline-block;
  padding: 8rpx 24rpx;
  margin-right: 16rpx;
  font-size: 24rpx;
  color: var(--text-secondary);
  background-color: var(--bg-color);
  border-radius: 8rpx;
  white-space: nowrap;
}

.category-tag.active {
  color: var(--white);
  background-color: var(--primary-color);
}

/* 任务列表 */
.task-list {
  flex: 1;
  padding: 16rpx 32rpx;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding-top: 200rpx;
}

.empty-icon {
  width: 200rpx;
  height: 200rpx;
  opacity: 0.5;
}

.empty-text {
  margin-top: 32rpx;
  font-size: 32rpx;
  color: var(--text-secondary);
}

.empty-hint {
  margin-top: 16rpx;
  font-size: 24rpx;
  color: var(--text-placeholder);
}

/* 加载更多 */
.loading-more {
  padding: 32rpx;
  text-align: center;
  color: var(--text-secondary);
  font-size: 24rpx;
}

.no-more {
  padding: 32rpx;
  text-align: center;
  color: var(--text-placeholder);
  font-size: 24rpx;
}

/* 底部统计栏 */
.bottom-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 88rpx;
  padding: 0 32rpx;
  background-color: var(--white);
  border-top: 1rpx solid var(--border-color);
}

.task-count {
  font-size: 24rpx;
  color: var(--text-secondary);
}

/* 悬浮新建按钮 */
.fab {
  position: fixed;
  right: 32rpx;
  bottom: 120rpx;
  width: 100rpx;
  height: 100rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background-color: var(--primary-color);
  border-radius: 50%;
  box-shadow: 0 4rpx 24rpx rgba(64, 158, 255, 0.4);
}

.fab-icon {
  font-size: 60rpx;
  color: var(--white);
  line-height: 1;
}

/* 文字颜色 */
.text-success {
  color: var(--success-color);
}

.text-warning {
  color: var(--warning-color);
}