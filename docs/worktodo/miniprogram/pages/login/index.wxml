<view class="container">
  <view class="header">
    <image class="logo" src="/assets/icons/logo.png" mode="aspectFit"/>
    <text class="app-name">工作待办</text>
    <text class="app-desc">简洁高效的待办管理</text>
  </view>

  <view class="content">
    <view class="feature-list">
      <view class="feature-item">
        <text class="feature-icon">*</text>
        <text class="feature-text">任务管理 - 创建、编辑、完成任务</text>
      </view>
      <view class="feature-item">
        <text class="feature-icon">*</text>
        <text class="feature-text">分类标签 - 自定义分类管理</text>
      </view>
      <view class="feature-item">
        <text class="feature-icon">*</text>
        <text class="feature-text">到期提醒 - 微信订阅消息通知</text>
      </view>
      <view class="feature-item">
        <text class="feature-icon">*</text>
        <text class="feature-text">数据同步 - 多端实时同步</text>
      </view>
    </view>
  </view>

  <view class="footer">
    <button class="btn-login" type="primary" bindtap="onWxLogin" loading="{{logging}}">
      微信授权登录
    </button>
    <text class="agreement">登录即表示同意《用户协议》和《隐私政策》</text>
  </view>
</view>