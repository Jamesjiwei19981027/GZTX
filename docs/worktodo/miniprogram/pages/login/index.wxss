/* 登录页面样式 */

.container {
  min-height: 100vh;
  background-color: var(--white);
  display: flex;
  flex-direction: column;
  padding: 120rpx 64rpx 64rpx;
}

.header {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 96rpx;
}

.logo {
  width: 160rpx;
  height: 160rpx;
  background-color: var(--primary-color);
  border-radius: 32rpx;
  margin-bottom: 32rpx;
}

.app-name {
  font-size: 48rpx;
  font-weight: bold;
  color: var(--text-primary);
  margin-bottom: 16rpx;
}

.app-desc {
  font-size: 28rpx;
  color: var(--text-secondary);
}

.content {
  flex: 1;
}

.feature-list {
  margin-bottom: 64rpx;
}

.feature-item {
  display: flex;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1rpx solid var(--border-color);
}

.feature-icon {
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background-color: var(--primary-color);
  color: var(--white);
  border-radius: 50%;
  margin-right: 24rpx;
  font-size: 24rpx;
}

.feature-text {
  font-size: 28rpx;
  color: var(--text-primary);
}

.footer {
  padding-top: 48rpx;
}

.btn-login {
  width: 100%;
  height: 96rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  background-color: #07C160;
  color: var(--white);
  border-radius: 48rpx;
  border: none;
}

.btn-login::after {
  border: none;
}

.agreement {
  display: block;
  text-align: center;
  font-size: 24rpx;
  color: var(--text-placeholder);
  margin-top: 32rpx;
}