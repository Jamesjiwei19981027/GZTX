<view class="container">
  <!-- 用户信息 -->
  <view class="section user-section" bindtap="goToLogin">
    <view class="user-info">
      <image class="avatar" src="{{userInfo.avatar_url || '/assets/icons/user.png'}}" mode="aspectFill"/>
      <view class="user-detail">
        <text class="nickname">{{userInfo.nickname || '点击登录'}}</text>
        <text class="user-tip">{{userInfo ? '已登录' : '登录后同步数据'}}</text>
      </view>
    </view>
    <view class="arrow">&gt;</view>
  </view>

  <!-- 通知设置 -->
  <view class="section">
    <view class="section-title">通知设置</view>

    <view class="setting-item">
      <view class="setting-info">
        <text class="setting-label">微信订阅消息</text>
        <text class="setting-desc">接收任务到期提醒</text>
      </view>
      <switch checked="{{notifyEnabled}}" bindchange="onNotifyToggle" color="#409EFF"/>
    </view>

    <view class="setting-item">
      <view class="setting-info">
        <text class="setting-label">每日摘要</text>
        <text class="setting-desc">每天早上推送今日待办</text>
      </view>
      <switch checked="{{dailyDigestEnabled}}" bindchange="onDailyDigestToggle" color="#409EFF"/>
    </view>

    <view class="setting-item" wx:if="{{dailyDigestEnabled}}">
      <view class="setting-info">
        <text class="setting-label">摘要推送时间</text>
      </view>
      <picker mode="time" value="{{dailyDigestTime}}" bindchange="onDigestTimeChange">
        <view class="picker-value">{{dailyDigestTime}}</view>
      </picker>
    </view>
  </view>

  <!-- 分类管理 -->
  <view class="section">
    <view class="section-title">数据管理</view>

    <view class="setting-item" bindtap="onClearCache">
      <view class="setting-info">
        <text class="setting-label">清除本地缓存</text>
      </view>
      <view class="arrow">&gt;</view>
    </view>
  </view>

  <!-- 关于 -->
  <view class="section">
    <view class="section-title">关于</view>

    <view class="setting-item" bindtap="onAbout">
      <view class="setting-info">
        <text class="setting-label">关于本程序</text>
      </view>
      <view class="arrow">&gt;</view>
    </view>

    <view class="setting-item">
      <view class="setting-info">
        <text class="setting-label">版本号</text>
      </view>
      <text class="version">v{{version}}</text>
    </view>
  </view>

  <!-- 退出登录 -->
  <view class="logout-section" wx:if="{{userInfo}}">
    <button class="btn-logout" bindtap="onLogout">退出登录</button>
  </view>
</view>