/* 设置页面样式 */

.container {
  min-height: 100vh;
  background-color: var(--bg-color);
  padding: 24rpx;
}

.section {
  background-color: var(--white);
  border-radius: 16rpx;
  margin-bottom: 24rpx;
  overflow: hidden;
}

.section-title {
  padding: 24rpx 32rpx;
  font-size: 26rpx;
  color: var(--text-secondary);
  background-color: var(--bg-color);
}

/* 用户信息 */
.user-section {
  display: flex;
  align-items: center;
  padding: 32rpx;
}

.user-info {
  flex: 1;
  display: flex;
  align-items: center;
}

.avatar {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  margin-right: 24rpx;
  background-color: var(--bg-color);
}

.user-detail {
  display: flex;
  flex-direction: column;
}

.nickname {
  font-size: 32rpx;
  font-weight: bold;
  color: var(--text-primary);
  margin-bottom: 8rpx;
}

.user-tip {
  font-size: 24rpx;
  color: var(--text-secondary);
}

/* 设置项 */
.setting-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 32rpx;
  border-bottom: 1rpx solid var(--border-color);
}

.setting-item:last-child {
  border-bottom: none;
}

.setting-info {
  flex: 1;
}

.setting-label {
  font-size: 28rpx;
  color: var(--text-primary);
}

.setting-desc {
  display: block;
  font-size: 24rpx;
  color: var(--text-secondary);
  margin-top: 8rpx;
}

.arrow {
  font-size: 28rpx;
  color: var(--text-placeholder);
}

.picker-value {
  font-size: 28rpx;
  color: var(--primary-color);
}

.version {
  font-size: 28rpx;
  color: var(--text-secondary);
}

/* 退出登录 */
.logout-section {
  padding: 48rpx 32rpx;
}

.btn-logout {
  width: 100%;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  color: var(--danger-color);
  background-color: var(--white);
  border-radius: 16rpx;
  border: none;
}

.btn-logout::after {
  border: none;
}