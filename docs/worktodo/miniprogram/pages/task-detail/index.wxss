/* 任务详情页样式 */

.container {
  min-height: 100vh;
  background-color: var(--bg-color);
  padding: 32rpx;
}

.loading, .empty {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 50vh;
  color: var(--text-secondary);
}

.task-detail {
  background-color: var(--white);
  border-radius: 16rpx;
  padding: 32rpx;
}

/* 状态栏 */
.status-bar {
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
}

.status-tag {
  padding: 8rpx 16rpx;
  font-size: 24rpx;
  background-color: var(--bg-color);
  color: var(--text-secondary);
  border-radius: 8rpx;
  margin-right: 16rpx;
}

.status-tag.completed {
  background-color: rgba(103, 194, 58, 0.1);
  color: var(--success-color);
}

.priority-tag {
  padding: 8rpx 16rpx;
  font-size: 24rpx;
  border-radius: 8rpx;
}

/* 任务标题 */
.task-title {
  font-size: 36rpx;
  font-weight: bold;
  color: var(--text-primary);
  margin-bottom: 16rpx;
  line-height: 1.5;
}

/* 任务描述 */
.task-description {
  font-size: 28rpx;
  color: var(--text-regular);
  line-height: 1.6;
  margin-bottom: 32rpx;
  padding: 24rpx;
  background-color: var(--bg-color);
  border-radius: 12rpx;
}

/* 信息列表 */
.info-list {
  margin-top: 32rpx;
}

.info-item {
  display: flex;
  padding: 24rpx 0;
  border-bottom: 1rpx solid var(--border-color);
}

.info-item:last-child {
  border-bottom: none;
}

.info-label {
  width: 140rpx;
  font-size: 28rpx;
  color: var(--text-secondary);
}

.info-value {
  flex: 1;
  font-size: 28rpx;
  color: var(--text-primary);
}

.info-value.overdue {
  color: var(--danger-color);
}

.overdue-tag {
  margin-left: 16rpx;
  font-size: 24rpx;
  color: var(--danger-color);
}

.category-badge {
  display: inline-block;
  padding: 8rpx 16rpx;
  font-size: 24rpx;
  background-color: var(--bg-color);
  border-radius: 8rpx;
}

.tags-wrap {
  display: flex;
  flex-wrap: wrap;
}

.tag-badge {
  padding: 4rpx 12rpx;
  margin-right: 12rpx;
  font-size: 24rpx;
  background-color: var(--bg-color);
  border-radius: 6rpx;
}

.reminder-text {
  display: block;
  margin-bottom: 8rpx;
}

/* 操作按钮 */
.action-bar {
  display: flex;
  margin-top: 48rpx;
  gap: 24rpx;
}

.action-bar .btn {
  flex: 1;
}

/* 订阅提醒 */
.subscribe-bar {
  margin-top: 24rpx;
}

.btn-block {
  width: 100%;
}

/* 按钮样式 */
.btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  height: 80rpx;
  padding: 0 32rpx;
  font-size: 28rpx;
  border-radius: 8rpx;
  border: none;
  background-color: var(--white);
}

.btn-primary {
  background-color: var(--primary-color);
  color: var(--white);
}

.btn-success {
  background-color: var(--success-color);
  color: var(--white);
}

.btn-danger {
  background-color: var(--danger-color);
  color: var(--white);
}

.btn-default {
  background-color: var(--bg-color);
  color: var(--text-primary);
}