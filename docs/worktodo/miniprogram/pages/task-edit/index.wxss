/* 新建/编辑任务页面样式 */

.container {
  min-height: 100vh;
  background-color: var(--bg-color);
  padding: 32rpx;
}

.form {
  background-color: var(--white);
  border-radius: 16rpx;
  padding: 32rpx;
}

.form-item {
  margin-bottom: 32rpx;
}

.form-label {
  font-size: 28rpx;
  color: var(--text-secondary);
  margin-bottom: 16rpx;
}

.form-label.required::after {
  content: ' *';
  color: var(--danger-color);
}

/* 输入框 */
.input {
  height: 88rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
  background-color: var(--bg-color);
  border-radius: 12rpx;
}

.textarea {
  width: 100%;
  min-height: 200rpx;
  padding: 24rpx;
  font-size: 28rpx;
  background-color: var(--bg-color);
  border-radius: 12rpx;
  box-sizing: border-box;
}

/* 优先级选择 */
.priority-select {
  display: flex;
}

.priority-btn {
  flex: 1;
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 16rpx;
  font-size: 28rpx;
  background-color: var(--bg-color);
  border-radius: 12rpx;
  border: 4rpx solid transparent;
}

.priority-btn:last-child {
  margin-right: 0;
}

.priority-btn.active {
  border-color: currentColor;
}

.priority-btn.active.low {
  color: var(--success-color);
  background-color: rgba(103, 194, 58, 0.1);
}

.priority-btn.active.medium {
  color: var(--warning-color);
  background-color: rgba(230, 162, 60, 0.1);
}

.priority-btn.active.high {
  color: var(--danger-color);
  background-color: rgba(245, 108, 108, 0.1);
}

/* 分类选择 */
.category-list {
  display: flex;
  flex-wrap: wrap;
}

.category-btn {
  padding: 16rpx 24rpx;
  margin-right: 16rpx;
  margin-bottom: 16rpx;
  font-size: 24rpx;
  background-color: var(--bg-color);
  border-radius: 8rpx;
}

.category-btn.active {
  color: var(--white);
  background-color: var(--primary-color);
}

/* 日期时间选择 */
.datetime-row {
  display: flex;
  align-items: center;
}

.date-picker, .time-picker {
  flex: 1;
  height: 80rpx;
  padding: 0 24rpx;
  display: flex;
  align-items: center;
  background-color: var(--bg-color);
  border-radius: 12rpx;
  font-size: 28rpx;
  color: var(--text-primary);
}

.date-picker {
  margin-right: 16rpx;
}

.clear-btn {
  padding: 0 24rpx;
  height: 80rpx;
  display: flex;
  align-items: center;
  color: var(--danger-color);
  font-size: 28rpx;
}

/* 提醒选择 */
.reminder-list {
  display: flex;
  flex-wrap: wrap;
}

.reminder-btn {
  padding: 16rpx 24rpx;
  margin-right: 16rpx;
  margin-bottom: 16rpx;
  font-size: 24rpx;
  background-color: var(--bg-color);
  border-radius: 8rpx;
}

.reminder-btn.active {
  color: var(--white);
  background-color: var(--primary-color);
}

/* 提交按钮 */
.form-actions {
  margin-top: 48rpx;
}

.btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  height: 88rpx;
  font-size: 32rpx;
  border-radius: 12rpx;
  border: none;
}

.btn-primary {
  background-color: var(--primary-color);
  color: var(--white);
}

.btn-block {
  width: 100%;
}

/* 选择器弹窗 */
.picker-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.5);
  z-index: 1000;
}

.picker-content {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  background-color: var(--white);
  border-radius: 24rpx 24rpx 0 0;
}

.picker-header {
  display: flex;
  justify-content: space-between;
  padding: 32rpx;
  font-size: 28rpx;
  border-bottom: 1rpx solid var(--border-color);
}

.picker-header text:first-child,
.picker-header text:last-child {
  color: var(--primary-color);
}

.picker-view {
  height: 400rpx;
}

.picker-item {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
}