# Multi-stage: React (Vite) static build + nginx
FROM node:20-alpine AS builder

WORKDIR /app
COPY package*.json ./
RUN npm ci --prefer-offline
COPY . .
# Production serves via same-origin /api reverse proxy; no absolute VITE API host required
# 变量名须与 src/api/request.ts 读取的 import.meta.env.VITE_API_BASE 一致
ENV VITE_API_BASE=/api/v1
RUN npm run build

FROM nginx:1.27-alpine

COPY nginx.prod.conf /etc/nginx/conf.d/default.conf
COPY --from=builder /app/dist /usr/share/nginx/html

EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
