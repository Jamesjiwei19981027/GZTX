<view class="category-picker">
  <view wx:for="{{categories}}" wx:key="id" class="category-item {{item.id === selectedId ? 'selected' : ''}}" bindtap="onSelect" data-id="{{item.id}}">
    <view class="category-color" style="background-color: {{item.color}}"></view>
    <text class="category-name">{{item.name}}</text>
    <text wx:if="{{item.id === selectedId}}" class="check-icon">✓</text>
  </view>
</view>