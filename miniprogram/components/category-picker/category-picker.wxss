.category-picker {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.category-item {
  display: flex;
  align-items: center;
  padding: 24rpx;
  background-color: #f5f5f5;
  border-radius: 12rpx;
}

.category-item.selected {
  background-color: #e6f0ff;
  border: 2rpx solid #409EFF;
}

.category-color {
  width: 32rpx;
  height: 32rpx;
  border-radius: 8rpx;
  margin-right: 16rpx;
}

.category-name {
  flex: 1;
  font-size: 28rpx;
  color: #333;
}

.check-icon {
  color: #409EFF;
  font-size: 32rpx;
}