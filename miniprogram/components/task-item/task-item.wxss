.task-item {
  display: flex;
  align-items: center;
  background-color: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
}

.task-item.overdue {
  border-left: 4rpx solid #F56C6C;
}

.priority-bar {
  width: 8rpx;
  height: 80rpx;
  border-radius: 4rpx;
  margin-right: 20rpx;
}

.priority-bar.priority-high {
  background-color: #F56C6C;
}

.priority-bar.priority-medium {
  background-color: #E6A23C;
}

.priority-bar.priority-low {
  background-color: #67C23A;
}

.task-content {
  flex: 1;
}

.task-title {
  font-size: 32rpx;
  color: #333;
  margin-bottom: 12rpx;
}

.task-meta {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.category-tag {
  font-size: 22rpx;
  color: #fff;
  padding: 4rpx 12rpx;
  border-radius: 4rpx;
}

.due-date {
  font-size: 24rpx;
  color: #999;
}

.task-status {
  font-size: 32rpx;
  color: #67C23A;
}

.task-status.completed {
  text-decoration: line-through;
}