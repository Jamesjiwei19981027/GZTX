<view class="page">
  <view class="hint" wx:if="{{title}}">节点：{{title}}</view>
  <scroll-view class="msgs" scroll-y>
    <view
      wx:for="{{messages}}"
      wx:key="index"
      class="bubble {{item.role}}"
    >{{item.content}}</view>
  </scroll-view>
  <view class="bar">
    <input class="input" value="{{input}}" bindinput="onInput" placeholder="输入消息…" confirm-type="send" bindconfirm="send" />
    <button size="mini" type="primary" loading="{{sending}}" bindtap="send">发送</button>
  </view>
</view>
