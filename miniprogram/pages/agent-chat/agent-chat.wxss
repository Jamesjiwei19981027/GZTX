.page {
  display: flex;
  flex-direction: column;
  height: 100vh;
}
.hint {
  padding: 12rpx 24rpx;
  font-size: 24rpx;
  color: #666;
  background: #f5f5f5;
}
.msgs {
  flex: 1;
  padding: 24rpx;
  box-sizing: border-box;
}
.bubble {
  max-width: 80%;
  margin-bottom: 16rpx;
  padding: 16rpx 20rpx;
  border-radius: 16rpx;
  font-size: 28rpx;
  line-height: 1.5;
}
.bubble.user {
  margin-left: auto;
  background: #409eff;
  color: #fff;
}
.bubble.assistant {
  background: #fff;
  border: 1px solid #eee;
}
.bubble.system {
  background: #f0f0f0;
  color: #666;
  font-size: 24rpx;
}
.bar {
  display: flex;
  gap: 12rpx;
  padding: 16rpx 24rpx;
  border-top: 1px solid #eee;
  background: #fff;
  align-items: center;
}
.input {
  flex: 1;
  border: 1px solid #ddd;
  border-radius: 12rpx;
  padding: 12rpx 16rpx;
}
