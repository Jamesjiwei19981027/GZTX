.container {
  padding: 24rpx;
  min-height: 100vh;
  background-color: #f5f5f5;
}

.calendar-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background-color: #fff;
  padding: 32rpx;
  border-radius: 16rpx;
  margin-bottom: 24rpx;
}

.nav-btn {
  font-size: 36rpx;
  color: #409EFF;
  padding: 16rpx 32rpx;
}

.current-month {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
}

.calendar-weekdays {
  display: flex;
  background-color: #fff;
  padding: 24rpx 0;
  border-radius: 16rpx;
  margin-bottom: 16rpx;
}

.weekday {
  flex: 1;
  text-align: center;
  font-size: 24rpx;
  color: #999;
}

.calendar-grid {
  display: flex;
  flex-wrap: wrap;
  background-color: #fff;
  border-radius: 16rpx;
  padding: 16rpx 0;
}

.calendar-day {
  width: 14.28%;
  height: 100rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  position: relative;
}

.calendar-day.empty {
  height: 100rpx;
}

.calendar-day.selected {
  background-color: #409EFF;
  border-radius: 50%;
}

.calendar-day.selected .day-number {
  color: #fff;
}

.day-number {
  font-size: 28rpx;
  color: #333;
}

.task-badge {
  position: absolute;
  top: 8rpx;
  right: 8rpx;
  background-color: #F56C6C;
  color: #fff;
  font-size: 18rpx;
  padding: 2rpx 8rpx;
  border-radius: 10rpx;
  min-width: 28rpx;
  text-align: center;
}

.selected-tasks {
  margin-top: 32rpx;
  background-color: #fff;
  border-radius: 16rpx;
  padding: 32rpx;
}

.section-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 24rpx;
}

.task-item {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}

.priority-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  margin-right: 16rpx;
}

.priority-dot.priority-high {
  background-color: #F56C6C;
}

.priority-dot.priority-medium {
  background-color: #E6A23C;
}

.priority-dot.priority-low {
  background-color: #67C23A;
}

.task-title {
  font-size: 28rpx;
  color: #333;
}

.empty-state {
  text-align: center;
  padding: 48rpx 0;
  color: #999;
}