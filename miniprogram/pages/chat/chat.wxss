.scope-scroll { white-space: nowrap; }
.scope-chip { display: inline-block; padding: 12rpx 20rpx; margin-right: 12rpx; border-radius: 999rpx; background: #f2f6fc; color: #606266; font-size: 24rpx; }
.scope-chip.active { background: #409eff; color: #fff; }
.section-title { font-size: 28rpx; font-weight: 600; margin-bottom: 16rpx; }
.chat-card { padding-bottom: 16rpx; }
.row { display: flex; align-items: center; justify-content: space-between; }
.title { font-weight: 600; }
.messages { height: 720rpx; margin: 16rpx 0; }
.message-row { display: flex; flex-direction: column; padding: 16rpx 0; border-bottom: 1rpx solid #ebeef5; }
.sender { color: #409eff; font-size: 24rpx; }
.body { color: #303133; margin-top: 6rpx; word-break: break-all; }
.time { color: #909399; font-size: 20rpx; margin-top: 6rpx; }
.composer { display: flex; gap: 12rpx; align-items: center; }
.composer input { flex: 1; background: #f5f7fa; border-radius: 12rpx; padding: 16rpx; box-sizing: border-box; }
.summary-card { border-left: 8rpx solid #409eff; }
.label { display: block; color: #409eff; font-weight: 600; margin-bottom: 12rpx; }
.summary { display: block; white-space: pre-wrap; line-height: 1.6; }
.contact-hint { display: block; color: #606266; font-size: 24rpx; margin: 16rpx 0; line-height: 1.6; }
