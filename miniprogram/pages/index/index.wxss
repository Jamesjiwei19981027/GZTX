.container { padding: 20rpx; }
.loading, .empty { text-align: center; padding: 100rpx 0; color: #999; }
.empty-text { font-size: 32rpx; }

.task-card { margin-bottom: 20rpx; }
.task-header { display: flex; align-items: center; }
.task-checkbox {
  width: 44rpx; height: 44rpx;
  border: 2rpx solid #dcdfe6; border-radius: 50%;
  display: flex; align-items: center; justify-content: center;
  margin-right: 20rpx;
}
.task-info { flex: 1; }
.task-title { font-size: 30rpx; color: #303133; }
.task-meta { margin-top: 8rpx; display: flex; align-items: center; gap: 12rpx; }
.priority-tag {
  font-size: 22rpx; padding: 2rpx 12rpx;
  border-radius: 8rpx; color: #fff;
}
.priority-0 { background: #909399; }
.priority-1 { background: #409EFF; }
.priority-2 { background: #F56C6C; }
.due-date { font-size: 24rpx; color: #909399; }

.fab {
  position: fixed; right: 40rpx; bottom: 120rpx;
  width: 100rpx; height: 100rpx; border-radius: 50%;
  background: #409EFF; color: #fff;
  display: flex; align-items: center; justify-content: center;
  font-size: 56rpx; box-shadow: 0 4rpx 16rpx rgba(64, 158, 255, 0.4);
}
.overview-row{display:flex;align-items:center;justify-content:space-between;gap:12rpx;margin-bottom:18rpx}
.overview-row button{margin:0;font-size:24rpx;padding:0 16rpx}
.overview-title{display:block;font-size:30rpx;font-weight:600}
.overview-hint{display:block;color:#606266;font-size:24rpx;margin:16rpx 0;line-height:1.6}
.month-days{display:grid;grid-template-columns:repeat(7,minmax(0,1fr));gap:8rpx;margin:12rpx 0 24rpx}
.month-day{flex:1;min-width:0;display:flex;flex-direction:column;align-items:center;gap:10rpx;padding:12rpx 0;border-radius:14rpx;background:#f2f6fc;color:#606266}
.month-day.selected{background:#0058be;color:#fff}
.schedule-dot{height:20rpx;line-height:20rpx}
.schedule-item{display:flex;gap:20rpx;align-items:center;padding:20rpx 0;font-size:26rpx;border-bottom:1rpx solid #ebeef5}
.project-summary{padding:24rpx 0;border-bottom:1rpx solid #ebeef5}

.weekday-labels{display:grid;grid-template-columns:repeat(7,minmax(0,1fr));text-align:center;color:#606266;font-size:24rpx}
.month-day.outside-month{background:transparent;color:#a8abb2}
.home-metrics{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:12rpx}
.home-metric{text-align:center;font-size:24rpx;padding:20rpx 8rpx}
.metric-value{display:block;font-size:40rpx;color:#0058be;font-weight:700;margin-top:8rpx}
.home-create{background:#0058be;color:#fff;margin:20rpx 0;border-radius:16rpx}
