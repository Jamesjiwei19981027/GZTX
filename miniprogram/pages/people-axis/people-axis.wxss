page{background:#f6f8fc;color:#18304b;font-size:28rpx}.page{padding:28rpx 24rpx 70rpx}.heading,.row{display:flex;align-items:center;justify-content:space-between;gap:16rpx}.heading{margin-bottom:28rpx}.title{display:block;font-size:36rpx;font-weight:700}.muted{display:block;font-size:23rpx;color:#718198;line-height:1.7}.card{margin:22rpx 0;background:white;border:1rpx solid #dce3ed;border-left:7rpx solid #1767cf;border-radius:22rpx;padding:24rpx}.secondary{border-left-color:#8864c6;margin-left:24rpx}.badge{color:#1767cf;font-size:23rpx;padding:6rpx 12rpx;background:#edf4ff;border-radius:10rpx}.secondary .badge{color:#7653af;background:#f4efff}.person{font-weight:700;font-size:31rpx}.row{margin-bottom:16rpx}.matter{display:flex;align-items:center;justify-content:space-between;border-top:1rpx solid #edf0f5;padding:16rpx 0;line-height:1.5}.actions{display:flex;flex-wrap:wrap;gap:12rpx;margin:22rpx 0 0}.actions button{margin:0;font-size:25rpx}.empty{padding:60rpx;text-align:center;color:#718198}.overlay{position:fixed;inset:0;background:rgba(15,30,50,.5);z-index:20;display:flex;align-items:flex-end}.sheet{box-sizing:border-box;width:100%;max-height:85vh;padding:30rpx 28rpx 60rpx;background:white;border-radius:26rpx 26rpx 0 0;overflow-y:auto}.label{display:block;margin:24rpx 0 10rpx;font-size:25rpx;color:#53667e}input,textarea,.picker{box-sizing:border-box;width:100%;border:1rpx solid #d8e0eb;border-radius:14rpx;padding:18rpx;background:#fbfcff}input{height:84rpx}textarea{height:160rpx}.description{display:block;line-height:1.7;padding:20rpx 0}.primary{background:#0058be;color:white}.danger{color:#b42b37}.error{padding:20rpx;background:#fff0f0;color:#b42b37}.evidence-overlay{z-index:30}
