.container{padding:24rpx}.invite-button{background:#0058be;color:#fff;margin-bottom:24rpx;border-radius:18rpx;font-weight:600}.title{display:block;font-size:32rpx;font-weight:600;margin-bottom:20rpx}.hint{display:block;color:#606266;font-size:24rpx;line-height:1.6;margin:12rpx 0}.task-row{display:flex;align-items:center;justify-content:space-between;gap:20rpx;padding:24rpx 0;border-bottom:1rpx solid #ebeef5}.task-title{flex:1;font-size:28rpx;word-break:break-all}.board-column{background:#f3f6fc;border-radius:16rpx;padding:20rpx;margin-top:20rpx}.column-title{font-size:26rpx;font-weight:600;color:#606266}.board-task{background:#fff;padding:24rpx;margin-top:16rpx;border-radius:12rpx;font-size:28rpx;word-break:break-all}.invite-form input{border:1rpx solid #dcdfe6;border-radius:12rpx;padding:24rpx;margin:20rpx 0}.error{color:#c03532;font-size:26rpx}.token{word-break:break-all;font-size:24rpx;display:block;margin:20rpx 0}
