<view class="page">
  <view class="toolbar">
    <text class="label">公司 ID</text>
    <input class="input" type="number" value="{{companyId}}" bindinput="onCompanyInput" />
    <button size="mini" type="primary" bindtap="load">刷新</button>
  </view>

  <view wx:if="{{loading}}" class="hint">加载中…</view>
  <view wx:elif="{{!projects.length}}" class="hint">暂无项目（请先在 Web 创建并开通 License）</view>

  <view
    wx:for="{{projects}}"
    wx:key="id"
    class="card"
    data-id="{{item.id}}"
    bindtap="openProject"
  >
    <view class="title">{{item.name}}</view>
    <view class="meta">#{{item.id}} · {{item.status}} · 角色 {{item.my_role || '-'}}</view>
  </view>
</view>
