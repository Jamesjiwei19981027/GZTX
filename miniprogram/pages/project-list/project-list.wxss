.page {
  padding: 24rpx;
}
.toolbar {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 24rpx;
}
.label {
  font-size: 26rpx;
  color: #666;
}
.input {
  width: 120rpx;
  border: 1px solid #ddd;
  border-radius: 8rpx;
  padding: 8rpx 12rpx;
  background: #fff;
}
.hint {
  color: #999;
  font-size: 28rpx;
  padding: 40rpx 0;
  text-align: center;
}
.card {
  background: #fff;
  border-radius: 16rpx;
  padding: 28rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}
.title {
  font-size: 32rpx;
  font-weight: 600;
  color: #222;
}
.meta {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #888;
}
