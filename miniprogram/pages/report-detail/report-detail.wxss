.container { padding: 20rpx; }
.card { background: #fff; border-radius: 16rpx; padding: 28rpx; }
.title { font-size: 34rpx; font-weight: 600; color: #303133; }
.meta { color: #909399; font-size: 24rpx; margin-top: 14rpx; }
.section { margin-top: 28rpx; }
.label { display: block; font-size: 26rpx; font-weight: 600; color: #606266; margin-bottom: 10rpx; }
.body { display: block; font-size: 28rpx; line-height: 1.65; color: #303133; white-space: pre-wrap; }
.body-input { width: 100%; min-height: 260rpx; box-sizing: border-box; border: 1rpx solid #dcdfe6; border-radius: 8rpx; padding: 16rpx; font-size: 28rpx; line-height: 1.6; }
.warning { margin-top: 18rpx; padding: 16rpx; border-radius: 8rpx; color: #9a6700; background: #fff7e6; font-size: 24rpx; }
.loading { text-align: center; color: #909399; padding: 100rpx 0; }
.primary { margin-top: 24rpx; background: #409EFF; color: #fff; }
