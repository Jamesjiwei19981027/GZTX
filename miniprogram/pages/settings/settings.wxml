<view class="container">
  <view class="user-section">
    <view class="avatar">
      <image wx:if="{{userInfo.avatar_url}}" src="{{userInfo.avatar_url}}" mode="aspectFill" />
      <text wx:else>{{userInfo.nickname || userInfo.username}}</text>
    </view>
    <view class="user-name">{{userInfo.nickname || userInfo.username}}</view>
    <view class="user-email">{{userInfo.email}}</view>
  </view>

  <view class="settings-section">
    <view class="section-title">通知设置</view>

    <view class="setting-item">
      <text class="setting-label">邮件通知</text>
      <switch checked="{{notifyPrefs.emailEnabled}}" bindchange="onEmailToggle" />
    </view>

    <view class="setting-item">
      <text class="setting-label">微信订阅消息</text>
      <switch checked="{{notifyPrefs.wechatEnabled}}" bindchange="onWxSubscribeToggle" />
    </view>
  </view>

  <view class="settings-section">
    <view class="section-title">日历与提醒</view>
    <view class="setting-item">
      <text class="setting-label">日历订阅</text>
      <text class="setting-value" bindtap="copyCalendarFeed">复制订阅地址 ›</text>
    </view>
    <view class="collab-tip">复制后在系统日历「按 URL 订阅」粘贴，任务日程将持续同步。</view>
    <view class="collab-tip">收到提醒邮件后直接回复 done 或完成，即可完成对应任务。</view>
  </view>

  <view class="settings-section">
    <view class="section-title">账号验证</view>

    <view class="setting-item">
      <text class="setting-label">手机验证</text>
      <text wx:if="{{verification.phone_verified}}" class="setting-value">已验证 {{verification.phone}}</text>
      <button
        wx:else
        size="mini"
        type="primary"
        open-type="getPhoneNumber"
        bindgetphonenumber="onGetPhoneNumber"
      >微信一键绑定</button>
    </view>

    <view class="setting-item">
      <text class="setting-label">邮箱验证</text>
      <text wx:if="{{verification.email_verified}}" class="setting-value">已验证 {{verification.email}}</text>
      <text wx:else class="setting-value" bindtap="toggleEmailVerify">去验证 ›</text>
    </view>

    <view wx:if="{{showEmailVerify && !verification.email_verified}}" class="email-verify-box">
      <input
        class="verify-input"
        type="text"
        placeholder="邮箱地址"
        value="{{verifyEmail}}"
        bindinput="onVerifyEmailInput"
      />
      <view class="verify-code-row">
        <input
          class="verify-input verify-code-input"
          type="number"
          maxlength="6"
          placeholder="验证码"
          value="{{verifyEmailCode}}"
          bindinput="onVerifyEmailCodeInput"
        />
        <button size="mini" disabled="{{emailCodeCountdown > 0}}" bindtap="sendEmailCode">
          {{emailCodeCountdown > 0 ? emailCodeCountdown + 's' : '获取验证码'}}
        </button>
      </view>
      <button size="mini" type="primary" bindtap="confirmEmailCode">确认验证</button>
    </view>
  </view>

  <view class="settings-section">
    <view class="section-title">项目协作</view>
    <view class="collab-tip">项目树、人轴画布等协作功能请使用 Web 端或 APP，小程序专注任务与日历。</view>
    <view class="setting-item">
      <text class="setting-label">Web 端地址</text>
      <text class="setting-value">{{webUrl || '未配置'}}</text>
    </view>
    <button class="copy-web-btn" size="mini" bindtap="copyWebUrl">复制 Web 地址</button>
  </view>

  <view class="settings-section">
    <view class="section-title">其他</view>
    <view class="setting-item">
      <text class="setting-label">版本</text>
      <text class="setting-value">v1.0.0</text>
    </view>
  </view>

  <view class="logout-btn">
    <button type="warn" bindtap="onLogout">退出登录</button>
  </view>
</view>