.container {
  padding: 24rpx;
  min-height: 100vh;
  background-color: #f5f5f5;
}

.form-section {
  background-color: #fff;
  border-radius: 16rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
}

.form-label {
  font-size: 28rpx;
  color: #333;
  margin-bottom: 16rpx;
  font-weight: 500;
}

.form-input {
  font-size: 32rpx;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #eee;
}

.form-textarea {
  font-size: 28rpx;
  min-height: 160rpx;
  padding: 16rpx;
  background-color: #fafafa;
  border-radius: 8rpx;
  width: 100%;
  box-sizing: border-box;
}

.radio-item {
  display: inline-block;
  margin-right: 40rpx;
  font-size: 28rpx;
}

.picker-value {
  padding: 16rpx 0;
  border-bottom: 1rpx solid #eee;
  color: #333;
  font-size: 28rpx;
}

.checkbox-item {
  display: inline-block;
  margin-right: 32rpx;
  margin-bottom: 16rpx;
  font-size: 28rpx;
}

.form-actions {
  margin-top: 48rpx;
}

.form-actions button {
  background-color: #409EFF;
  color: #fff;
}